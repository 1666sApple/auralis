# Application Settings
APP_NAME=HR Document RAG API
APP_VERSION=2.0.0
DEBUG=False

# AWS Credentials
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=your-region
AWS_REGION_IMAGE=your-region
AWS_REGION_EMBEDDING=your-region
AWS_S3_BUCKET=""

# AWS Bedrock Credentials
BEDROCK_API_NAME=your_bedrock_api_name
BEDROCK_API=your_bedrock_api_token

# Google API KEY
GOOGLE_API_KEY=your_google_api_key

# Bedrock Models
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
# LLM_MODEL_ID=minimax.minimax-m2
# LLM_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
LLM_MODEL_ID=zai.glm-4.7
MEM0_LLM_MODEL=amazon.nova-2-lite-v1:0
IMAGE_MODEL_ID=stability.stable-diffusion-xl-v1:0
LLM_TITLE_MODEL_ID=amazon.nova-2-lite-v1:0
LLM_ENRICHMENT_MODEL_ID=meta.llama3-2-90b-instruct-v1:0
# CONTEXT_MODEL_ID=meta.

# Model Parameters
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=8192

# Vector Store Settings (UPDATED TO QDRANT)
QDRANT_MODE=local
QDRANT_STORAGE_PATH=knowledge-base/qdrant_storage
QDRANT_SERVER_URL=localhost:6333
SQLITE_DB_PATH=knowledge-base/documents.db

# Legacy FAISS paths (archived - use Qdrant instead)
# FAISS_INDEX_PATH=knowledge-base/faiss_index.bin

# Document Processing
MAX_CHUNK_SIZE=1200
EMBEDDING_BATCH_SIZE=10
EMBEDDING_DIMENSION=1024

# Retrieval Settings
DEFAULT_TOP_K=5

# API Settings
API_PREFIX=""
CORS_ORIGINS=["*"]

# Additional Settings moved from settings.py
LLM_SONNET_MODEL_ID=qwen.qwen3-vl-235b-a22b
# LLM_SONNET_MODEL_ID=global.anthropic.claude-sonnet-4-5-20250929-v1:0
# LLM_SONNET_MODEL_ID=us.amazon.nova-pro-v1:0
# LLM_SONNET_MODEL_ID=us.anthropic.claude-3-5-sonnet-20241022-v1:0
LLM_HAIKU_MODEL_ID=minimax.minimax-m2

# HR Database Settings
HR_DB_CONNECTION_STRING=sqlite+aiosqlite:///hr_database.db
HR_DB_TYPE=sqlite

# Reranker Settings
RERANKER_MODEL_ID=mixedbread-ai/mxbai-rerank-xsmall-v1
CORRECTIVE_SKIP_THRESHOLD=0.80

# Performance Optimization
ENABLE_SCOPE_VALIDATION=False

# Document Generation Settings
DOC_TEMPLATE_PATH=template/background_template_Letter.docx
DOC_OUTPUT_DIR=generated_docs
DOC_GENERATION_TIMEOUT=60
DOC_LLM_MAX_RETRIES=3
DOC_LLM_RETRY_BASE_DELAY=1.0
